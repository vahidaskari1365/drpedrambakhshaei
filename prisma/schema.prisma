// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// درخواست‌های رزرو نوبت و مشاوره از فرم تماس
model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  service   String   @default("سایر موارد")
  message   String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

/**
 * بازنویسی محتوای سایت توسط پنل ادمین
 * هر رکورد = کلید یک مجموعه محتوا (services، faq، blog و ...) + JSON کامل جایگزین
 * اگر رکوردی نباشد، پیش‌فرض کد (site-data.ts / blog-data.ts) استفاده می‌شود
 */
model ContentOverride {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/** گزارش فعالیت‌های پنل — سوخت نمودارهای گزارش‌گیری */
model ActivityLog {
  id        String   @id @default(cuid())
  kind      String
  entity    String
  summary   String
  createdAt DateTime @default(now())
}

/**
 * آمار بازدیدکنندگان سایت — هر رکورد یک بازدید صفحه
 * vid = شناسه یکتای بازدیدکننده (localStorage) برای محاسبه بازدیدکننده یکتا
 * device = desktop | mobile | tablet
 */
model Visit {
  id        String   @id @default(cuid())
  path      String
  vid       String   @default("")
  referrer  String   @default("")
  device    String   @default("desktop")
  ua        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([vid])
}

/**
 * رسانه‌های آپلودشده از پنل ادمین (مثل کتابخانه رسانه وردپرس)
 * تصویر به‌صورت base64 در دیتابیس ذخیره و از /api/media/<id> سرو می‌شود
 */
model Media {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  data      String
  createdAt DateTime @default(now())
}