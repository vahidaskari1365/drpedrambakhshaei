// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// درخواست‌های رزرو نوبت و مشاوره از فرم تماس
model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  service   String   @default("سایر موارد")
  message   String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

/**
 * بازنویسی محتوای سایت توسط پنل ادمین
 * هر رکورد = کلید یک مجموعه محتوا (services، faq، blog و ...) + JSON کامل جایگزین
 * اگر رکوردی نباشد، پیش‌فرض کد (site-data.ts / blog-data.ts) استفاده می‌شود
 */
model ContentOverride {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/** گزارش فعالیت‌های پنل — سوخت نمودارهای گزارش‌گیری */
model ActivityLog {
  id        String   @id @default(cuid())
  kind      String
  entity    String
  summary   String
  createdAt DateTime @default(now())
}

/**
 * آمار بازدیدکنندگان سایت — هر رکورد یک بازدید صفحه
 * vid = شناسه یکتای بازدیدکننده (localStorage) برای محاسبه بازدیدکننده یکتا
 * device = desktop | mobile | tablet
 */
model Visit {
  id        String   @id @default(cuid())
  path      String
  vid       String   @default("")
  referrer  String   @default("")
  device    String   @default("desktop")
  ua        String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([vid])
}

/**
 * رسانه‌های آپلودشده از پنل ادمین (مثل کتابخانه رسانه وردپرس)
 * تصویر به‌صورت base64 در دیتابیس ذخیره و از /api/media/<id> سرو می‌شود
 */
model Media {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  data      String
  createdAt DateTime @default(now())
}

/**
 * مقاله‌های منتشرشده از مسیر خودکار (ایجنت محتوا) یا API انتشار
 * id = slug یکتا؛ upsert بر اساس آن یعنی انتشار تکراری = به‌روزرسانی
 * article = JSON کامل BlogArticle برای رندر بدون بیلد مجدد
 */
model BlogPost {
  id          String   @id
  title       String
  description String   @default("")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  tags        String   @default("[]")
  keywords    String   @default("[]")
  readingTime Int      @default(5)
  coverImage  String   @default("")
  article     String   @default("{}")
  contentHash String   @default("")
  source      String   @default("agent")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

/**
 * دفتر اجرای ایجنت‌ها — job history (الگوی OpenClaw Automations)
 * هر اجرا یک رکورد؛ داشبورد پنل از همین سوخت می‌گیرد
 */
model AgentRun {
  id         String   @id @default(cuid())
  agent      String
  status     String
  trigger    String   @default("manual")
  summary    String   @default("")
  details    String   @default("{}")
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([agent, createdAt])
}

/** بانک ایده‌های محتوایی — صف کار ایجنت ۱ (rotation با priority) */
model TopicIdea {
  id        String    @id @default(cuid())
  title     String
  angle     String    @default("")
  keywords  String    @default("[]")
  priority  Int       @default(50)
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/** تنظیمات ایجنت‌ها — تک‌رکورد با id ثابت "agents" */
model AgentConfig {
  id        String   @id @default("agents")
  data      String   @default("{}")
  updatedAt DateTime @updatedAt
}