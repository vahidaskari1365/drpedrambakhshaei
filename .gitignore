# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# database — حاوی اطلاعات شخصی است، هرگز در گیت
/db/*
*.db
*.db-journal
*.db-wal
*.db-shm
!db/template.db

# داده‌های خام استخراجی (شامل اطلاعات شخصی)
/download/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# فقط پوشه‌های ریشه — بدون اسلش، هر فایل/پوشه‌ای در هر عمقی را می‌بلعد (باگ مسیر API قبلی)
/test
/prompt

server.log
# Skills directory
/skills/tool-results/

# خروجی بیلد release.sh (باندل‌های دیپلوی) — هرگز در گیت
/release-out/
*.tar.gz

# کلون سنگین openclaw — فقط مرجع معماری، در ریپو نمی‌رود
/skills/openclaw/
/tool-results/

# فایل‌های دیباگ ایجنت محتوا (در Actions تولید می‌شوند، در مخزن نمی‌روند)
scripts/github-agent/last-raw-*.txt

# کلیدهای محرمانه گوگل (Search Console و ...) — هرگز در گیت
/secrets/
gsc-service-account*.json
*service-account*.json
